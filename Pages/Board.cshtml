@page
@using System.Text.Json
@model DrowingTogether.Pages.BoardModel

<div class="top-bar">
    <div class="left">
        <h1>@Model.Board.Name</h1>
    </div>

    <div class="toolbar">
        <input type="color" id="colorPicker" value="#000000" />
        <input type="range" id="sizePicker" min="1" max="20" value="3" />

        <button data-tool="pen">✏️</button>
        <button data-tool="eraser">🧽</button>
        <button data-tool="line">📏</button>
        <button data-tool="rect">⬛</button>
        <button data-tool="square">◼️</button>
        <button data-tool="circle">⚪</button>
        <button id="exportBtn">💾 JPG</button>
    </div>
</div>

<div class="canvas-container">
    <canvas id="board"></canvas>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const canvas = document.getElementById("board");
    const ctx = canvas.getContext("2d");

    let tool = "pen";
    let drawing = false;

    let startX, startY;

    let currentColor = "#000000";
    let currentSize = 3;

    const boardId = "@Model.Board.Id";

    const colorPicker = document.getElementById("colorPicker");
    const sizePicker = document.getElementById("sizePicker");

    colorPicker.oninput = e => currentColor = e.target.value;
    sizePicker.oninput = e => currentSize = Number(e.target.value);

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/drawingHub")
        .build();

    connection.start().then(() => {
        connection.invoke("JoinBoard", boardId);
    });

    connection.on("ReceiveShape", (type, color, size, data) => {
        drawShape(type, color, size, data);
    });

    function resize() {
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
        ctx.fillStyle = "#2c2c54";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
    window.addEventListener("resize", resize);
    resize();

    let snapshot;
    let currentPoints = [];

    canvas.addEventListener("mousedown", e => {
        drawing = true;

        startX = e.offsetX;
        startY = e.offsetY;

        snapshot = ctx.getImageData(0, 0, canvas.width, canvas.height);

        currentPoints = [{ x: startX, y: startY }];

        ctx.beginPath();
        ctx.moveTo(startX, startY);
    });

    canvas.addEventListener("mousemove", e => {
        if (!drawing) return;

        ctx.strokeStyle = tool === "eraser" ? "#2c2c54" : currentColor;
        ctx.lineWidth = currentSize;

        const x = e.offsetX;
        const y = e.offsetY;

        if (snapshot && (tool !== "pen" && tool !== "eraser")) {
            ctx.putImageData(snapshot, 0, 0);
        }

        if (tool === "pen" || tool === "eraser") {
            ctx.lineTo(x, y);
            ctx.stroke();

            currentPoints.push({ x, y });
        }

        if (tool === "rect") {
            ctx.strokeRect(startX, startY, x - startX, y - startY);
        }

        if (tool === "square") {
            let size = Math.min(x - startX, y - startY);
            ctx.strokeRect(startX, startY, size, size);
        }

        if (tool === "circle") {
            let radius = Math.hypot(x - startX, y - startY);
            ctx.beginPath();
            ctx.arc(startX, startY, radius, 0, Math.PI * 2);
            ctx.stroke();
        }
        if (tool === "line") {
            ctx.beginPath();
            ctx.moveTo(startX, startY);
            ctx.lineTo(x, y);
            ctx.stroke();
        }
    });

    canvas.addEventListener("mouseup", e => {
        if (!drawing) return;
        drawing = false;

        const x = e.offsetX;
        const y = e.offsetY;

        let data = null;
        
        if (tool === "pen" || tool === "eraser") {
            data = { points: currentPoints };
        }

        if (tool === "rect") {
            data = { x: startX, y: startY, w: x - startX, h: y - startY };
        }

        if (tool === "square") {
            let size = Math.min(x - startX, y - startY);
            data = { x: startX, y: startY, size };
        }

        if (tool === "circle") {
            let r = Math.hypot(x - startX, y - startY);
            data = { x: startX, y: startY, r };
        }
        if (tool === "line") {
            data = { x1: startX, y1: startY, x2: x, y2: y };
        }

        if (data) {
            connection.invoke("SendShape", boardId, tool, currentColor, currentSize, data);
            setTimeout(savePreview, 150);
        }
    });
    
    canvas.addEventListener("mouseleave", e => {
        if (!drawing) return;

        drawing = false;

        const x = e.offsetX;
        const y = e.offsetY;

        let data = null;

        if (tool === "pen" || tool === "eraser") {
            data = { points: currentPoints };
        }

        if (tool === "rect") {
            data = { x: startX, y: startY, w: x - startX, h: y - startY };
        }

        if (tool === "square") {
            let size = Math.min(x - startX, y - startY);
            data = { x: startX, y: startY, size };
        }

        if (tool === "circle") {
            let r = Math.hypot(x - startX, y - startY);
            data = { x: startX, y: startY, r };
        }

        if (data) {
            connection.invoke("SendShape", boardId, tool, currentColor, currentSize, data);
            setTimeout(savePreview, 150);
        }
    });

    function drawShape(type, color, size, data) {
        ctx.strokeStyle = color;
        ctx.lineWidth = size;

        if (type === "pen") {
            ctx.beginPath();
            const pts = data.points;
            ctx.moveTo(pts[0].x, pts[0].y);
            for (let i = 1; i < pts.length; i++) {
                ctx.lineTo(pts[i].x, pts[i].y);
            }
            ctx.stroke();
        }

        if (type === "eraser") {
            ctx.strokeStyle = "#2c2c54";
            ctx.beginPath();
            const pts = data.points;
            ctx.moveTo(pts[0].x, pts[0].y);
            for (let i = 1; i < pts.length; i++) {
                ctx.lineTo(pts[i].x, pts[i].y);
            }
            ctx.stroke();
        }

        if (type === "rect") {
            ctx.strokeRect(data.x, data.y, data.w, data.h);
        }

        if (type === "square") {
            ctx.strokeRect(data.x, data.y, data.size, data.size);
        }

        if (type === "circle") {
            ctx.beginPath();
            ctx.arc(data.x, data.y, data.r, 0, Math.PI * 2);
            ctx.stroke();
        }
        if (type === "line") {
            ctx.beginPath();
            ctx.moveTo(data.x1, data.y1);
            ctx.lineTo(data.x2, data.y2);
            ctx.stroke();
        }
    }

    document.getElementById("exportBtn").addEventListener("click", () => {
        const tempCanvas = document.createElement("canvas");
        const tempCtx = tempCanvas.getContext("2d");

        tempCanvas.width = canvas.width;
        tempCanvas.height = canvas.height;

        tempCtx.fillStyle = "#2c2c54";
        tempCtx.fillRect(0, 0, canvas.width, canvas.height);

        tempCtx.drawImage(canvas, 0, 0);

        const link = document.createElement("a");
        link.download = "drawing.png";
        link.href = tempCanvas.toDataURL("image/png");
        link.click();
    });

    // 🔥 ЗАГРУЗКА ИЗ БД
    const shapes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Shapes));
    shapes.forEach(s => {
        drawShape(s.Type, s.Color, s.Size, JSON.parse(s.DataJson));
    });

    function stopDrawing() {
        if (!drawing) return;

        drawing = false;

        if (currentPoints.length > 1) {
            connection.invoke("SendStroke", boardId, currentColor, currentSize, currentPoints);
            savePreview();
        }

        currentPoints = [];
        ctx.beginPath();
    }
    
    document.querySelectorAll("[data-tool]").forEach(btn => {
        btn.onclick = () => {
            tool = btn.dataset.tool;
        };
    });

    function savePreview() {
        const tempCanvas = document.createElement("canvas");
        const scale = 0.2;

        tempCanvas.width = canvas.width * scale;
        tempCanvas.height = canvas.height * scale;

        const tctx = tempCanvas.getContext("2d");

        // фон
        tctx.fillStyle = "#2c2c54";
        tctx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);

        // масштабируем картинку
        tctx.drawImage(canvas, 0, 0, canvas.width, canvas.height, 0, 0, tempCanvas.width, tempCanvas.height);

        const image = tempCanvas.toDataURL("image/jpeg", 0.6);

        fetch("/api/preview", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ boardId, image })
        });
    }
</script>