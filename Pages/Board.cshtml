@page
@using System.Text.Json
@model DrowingTogether.Pages.BoardModel
<div class="board-page">
    <div class="top-bar">
        <div class="left">
            <div class="left d-flex align-items-center gap-3">

                <a href="/" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left"></i>
                </a>

                <h4 class="mb-0" style="color: whitesmoke">@Model.Board.Name</h4>

            </div>
        </div>

        <div class="toolbar d-flex gap-2">

            <input type="color" id="colorPicker" class="form-control form-control-color" />
            <input type="range" 
            id="sizePicker" 
            class="form-range" 
            style="width:120px;" 
            min="1"
            max="25 "
            value="3"
            step="1" />

            <button class="btn btn-light btn-sm" data-tool="pen"><i class="bi bi-pencil"></i></button>
            <button class="btn btn-light btn-sm" data-tool="eraser"><i class="bi bi-eraser"></i></button>
            <button class="btn btn-light btn-sm" data-tool="line"><i class="bi bi-slash-lg"></i></button>
            <button class="btn btn-light btn-sm" data-tool="rect"><i class="bi bi-square"></i></button>
            <button class="btn btn-light btn-sm" data-tool="circle"><i class="bi bi-circle"></i></button>
            <button class="btn btn-light btn-sm" data-tool="text"><i class="bi bi-type"></i></button>

            <button class="btn btn-success btn-sm" id="exportBtn">
                <i class="bi bi-download"></i>
            </button>

        </div>
    </div>

    <div class="canvas-container">
        <canvas id="board"></canvas>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    document.querySelectorAll("[data-tool]").forEach(btn => {
        btn.onclick = () => {
            tool = btn.dataset.tool;

            document.querySelectorAll("[data-tool]").forEach(b => b.classList.remove("btn-primary"));
            btn.classList.add("btn-primary");
        };
    });

    const canvas = document.getElementById("board");
    const ctx = canvas.getContext("2d");

    let tool = "pen";
    let drawing = false;

    let startX, startY;

    let currentColor = "#000000";
    let currentSize = 3;

    const boardId = "@Model.Board.Id";

    const colorPicker = document.getElementById("colorPicker");
    const sizePicker = document.getElementById("sizePicker");

    colorPicker.oninput = e => currentColor = e.target.value;
    sizePicker.oninput = e => currentSize = Number(e.target.value);

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/drawingHub")
        .build();

    connection.start().then(() => {
        connection.invoke("JoinBoard", boardId);
    });

    connection.on("ReceiveShape", (type, color, size, data) => {
        drawShape(type, color, size, data);
    });

    function resize() {
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
        ctx.fillStyle = "#2c2c54";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
    }
    window.addEventListener("resize", resize);
    resize();

    let snapshot;
    let currentPoints = [];

    canvas.addEventListener("mousedown", e => {
        if (tool === "text") {
            const text = prompt("Введите текст:");

            if (!text) return;

            const data = {
                x: e.offsetX,
                y: e.offsetY,
                text: text
            };

            drawShape("text", currentColor, currentSize, data);

            snapshot = ctx.getImageData(0, 0, canvas.width, canvas.height);

            connection.invoke("SendShape", boardId, "text", currentColor, currentSize, data);

            setTimeout(savePreview, 150);

            return;
        }
        drawing = true;


        startX = e.offsetX;
        startY = e.offsetY;

        snapshot = ctx.getImageData(0, 0, canvas.width, canvas.height);

        currentPoints = [{ x: startX, y: startY }];

        ctx.beginPath();
        ctx.moveTo(startX, startY);
    });

    canvas.addEventListener("mousemove", e => {
        if (!drawing) return;

        ctx.strokeStyle = tool === "eraser" ? "#2c2c54" : currentColor;
        ctx.lineWidth = currentSize;

        const x = e.offsetX;
        const y = e.offsetY;

        if (snapshot && (tool === "rect" || tool === "square" || tool === "circle" || tool === "line")) {
            ctx.putImageData(snapshot, 0, 0);
        }

        if (tool === "pen" || tool === "eraser") {
            ctx.lineTo(x, y);
            ctx.stroke();

            currentPoints.push({ x, y });
        }

        if (tool === "rect") {
            ctx.strokeRect(startX, startY, x - startX, y - startY);
        }

        if (tool === "square") {
            let size = Math.min(x - startX, y - startY);
            ctx.strokeRect(startX, startY, size, size);
        }

        if (tool === "circle") {
            let radius = Math.hypot(x - startX, y - startY);
            ctx.beginPath();
            ctx.arc(startX, startY, radius, 0, Math.PI * 2);
            ctx.stroke();
        }
        if (tool === "line") {
            ctx.beginPath();
            ctx.moveTo(startX, startY);
            ctx.lineTo(x, y);
            ctx.stroke();
        }
    });

    canvas.addEventListener("mouseup", e => {
        if (!drawing) return;
        drawing = false;

        const x = e.offsetX;
        const y = e.offsetY;

        let data = null;
        
        if (tool === "pen" || tool === "eraser") {
            data = { points: currentPoints };
        }

        if (tool === "rect") {
            data = { x: startX, y: startY, w: x - startX, h: y - startY };
        }

        if (tool === "square") {
            let size = Math.min(x - startX, y - startY);
            data = { x: startX, y: startY, size };
        }

        if (tool === "circle") {
            let r = Math.hypot(x - startX, y - startY);
            data = { x: startX, y: startY, r };
        }
        if (tool === "line") {
            data = { x1: startX, y1: startY, x2: x, y2: y };
        }

        if (data) {
            connection.invoke("SendShape", boardId, tool, currentColor, currentSize, data);
            setTimeout(savePreview, 150);
        }
    });
    
    canvas.addEventListener("mouseleave", e => {
        if (!drawing) return;

        drawing = false;

        const x = e.offsetX;
        const y = e.offsetY;

        let data = null;

        if (tool === "pen" || tool === "eraser") {
            data = { points: currentPoints };
        }

        if (tool === "rect") {
            data = { x: startX, y: startY, w: x - startX, h: y - startY };
        }

        if (tool === "square") {
            let size = Math.min(x - startX, y - startY);
            data = { x: startX, y: startY, size };
        }

        if (tool === "circle") {
            let r = Math.hypot(x - startX, y - startY);
            data = { x: startX, y: startY, r };
        }

        if (data) {
            connection.invoke("SendShape", boardId, tool, currentColor, currentSize, data);
            setTimeout(savePreview, 150);
        }
    });

    function drawShape(type, color, size, data) {
        ctx.strokeStyle = color;
        ctx.lineWidth = size;

        if (type === "pen") {
            ctx.beginPath();
            const pts = data.points;
            ctx.moveTo(pts[0].x, pts[0].y);
            for (let i = 1; i < pts.length; i++) {
                ctx.lineTo(pts[i].x, pts[i].y);
            }
            ctx.stroke();
        }

        if (type === "eraser") {
            ctx.strokeStyle = "#2c2c54";
            ctx.beginPath();
            const pts = data.points;
            ctx.moveTo(pts[0].x, pts[0].y);
            for (let i = 1; i < pts.length; i++) {
                ctx.lineTo(pts[i].x, pts[i].y);
            }
            ctx.stroke();
        }

        if (type === "rect") {
            ctx.strokeRect(data.x, data.y, data.w, data.h);
        }

        if (type === "square") {
            ctx.strokeRect(data.x, data.y, data.size, data.size);
        }

        if (type === "circle") {
            ctx.beginPath();
            ctx.arc(data.x, data.y, data.r, 0, Math.PI * 2);
            ctx.stroke();
        }
        if (type === "line") {
            ctx.beginPath();
            ctx.moveTo(data.x1, data.y1);
            ctx.lineTo(data.x2, data.y2);
            ctx.stroke();
        }
        if (type === "text") {
            ctx.fillStyle = color;
            ctx.font = `${size * 5}px Arial`;
            ctx.textBaseline = "top";
            ctx.fillText(data.text, data.x, data.y);
        }
    }

    document.getElementById("exportBtn").addEventListener("click", () => {
        const tempCanvas = document.createElement("canvas");
        const tempCtx = tempCanvas.getContext("2d");

        tempCanvas.width = canvas.width;
        tempCanvas.height = canvas.height;

        tempCtx.fillStyle = "#2c2c54";
        tempCtx.fillRect(0, 0, canvas.width, canvas.height);

        tempCtx.drawImage(canvas, 0, 0);

        const link = document.createElement("a");

        let boardName = "@Model.Board.Name";
        boardName = boardName.replace(/[\\/:*?"<>|]/g, "_");
        link.download = boardName + ".png";
        link.href = tempCanvas.toDataURL("image/png");
        link.click();
    });


    const shapes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Shapes));
    shapes.forEach(s => {
        drawShape(s.Type, s.Color, s.Size, JSON.parse(s.DataJson));
    });

    function stopDrawing() {
        if (!drawing) return;

        drawing = false;

        if (currentPoints.length > 1) {
            connection.invoke("SendStroke", boardId, currentColor, currentSize, currentPoints);
            savePreview();
        }

        currentPoints = [];
        ctx.beginPath();
    }

    function savePreview() {
        const tempCanvas = document.createElement("canvas");
        const scale = 0.2;

        tempCanvas.width = canvas.width * scale;
        tempCanvas.height = canvas.height * scale;

        const tctx = tempCanvas.getContext("2d");

        tctx.fillStyle = "#2c2c54";
        tctx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);

        tctx.drawImage(canvas, 0, 0, canvas.width, canvas.height, 0, 0, tempCanvas.width, tempCanvas.height);

        const image = tempCanvas.toDataURL("image/jpeg", 0.6);

        fetch("/api/preview", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ boardId, image })
        });
    }
</script>