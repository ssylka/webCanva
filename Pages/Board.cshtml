@page
@using System.Text.Json
@model DrowingTogether.Pages.BoardModel

<div class="board-page">

    <!-- 🔥 Верхняя панель -->
    <div class="top-bar">
        <h1>@Model.Board.Name</h1>

        <div class="toolbar">
            <input type="color" id="colorPicker" value="#000000" />
            <input type="range" id="sizePicker" min="1" max="20" value="3" />

            <button id="penBtn">✏️</button>
            <button id="eraserBtn">🧽</button>
            <button data-tool="rect">⬛</button>
            <button data-tool="circle">⚪</button>
            <button data-tool="text">T</button>

            <button id="exportBtn">💾 JPG</button>
        </div>
    </div>

    <!-- 🔥 Canvas теперь отдельно -->
    <div class="canvas-container">
        <canvas id="board"></canvas>
    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const canvas = document.getElementById("board");
    const ctx = canvas.getContext("2d");

    ctx.lineCap = "round";
    ctx.lineJoin = "round";

    function resize() {
        const rect = canvas.getBoundingClientRect();

        canvas.width = rect.width;
        canvas.height = rect.height;
    }

    window.addEventListener("resize", resize);
    resize();

    let currentStroke = [];

    const existingStrokes = @Html.Raw(JsonSerializer.Serialize(Model.Strokes));
    existingStrokes.forEach(s => {
        const points = JSON.parse(s.PointsJson);

        ctx.beginPath();
        ctx.strokeStyle = s.Color;
        ctx.lineWidth = s.Size;

        ctx.moveTo(points[0].X, points[0].Y);

        for (let i = 1; i < points.length; i++) {
            ctx.lineTo(points[i].X, points[i].Y);
        }

        ctx.stroke();
    });

    let currentColor = "#000000";
    let currentSize = 3;
    let isEraser = false;

    document.getElementById("colorPicker").addEventListener("input", e => {
        currentColor = e.target.value;
        isEraser = false;
    });

    document.getElementById("sizePicker").addEventListener("input", e => {
        currentSize = Number(e.target.value);
    });

    document.getElementById("eraserBtn").onclick = () => {
        isEraser = true;
        currentColor = "#2c2c54";
    };

    document.getElementById("penBtn").onclick = () => {
        isEraser = false;
        currentColor = document.getElementById("colorPicker").value;
    };

    let drawing = false;
    const boardId = "@Model.Board.Id";

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/drawingHub")
        .build();

    connection.start().then(() => {
        connection.invoke("JoinBoard", boardId);
    });

    let lastRemote = null;

    connection.on("ReceiveStart", (x, y) => {
        ctx.beginPath();
        ctx.moveTo(x, y);
        lastRemote = { x, y };
    });

    connection.on("ReceiveDraw", (x, y, color, size) => {
        ctx.strokeStyle = color;
        ctx.lineWidth = size;

        if (lastRemote) {
            ctx.moveTo(lastRemote.x, lastRemote.y);
        }

        ctx.lineTo(x, y);
        ctx.stroke();

        lastRemote = { x, y };
    });

    connection.on("ReceiveStroke", (color, size, points) => {
        ctx.beginPath();
        ctx.strokeStyle = color;
        ctx.lineWidth = size;

        ctx.moveTo(points[0].X, points[0].Y);

        for (let i = 1; i < points.length; i++) {
            ctx.lineTo(points[i].X, points[i].Y);
        }

        ctx.stroke();
    });

        let drawing = false;
    let isInside = false;

    canvas.addEventListener("mousedown", (e) => {
        drawing = true;
        isInside = true;

        currentStroke = [];

        ctx.beginPath();
        ctx.moveTo(e.offsetX, e.offsetY);

        currentStroke.push({ x: e.offsetX, y: e.offsetY });

        ctx.strokeStyle = isEraser ? "#2c2c54" : currentColor;
        ctx.lineWidth = currentSize;

        connection.invoke("SendStart", boardId, e.offsetX, e.offsetY);
    });

    canvas.addEventListener("mousemove", (e) => {
        if (!drawing || !isInside) return;

        ctx.lineTo(e.offsetX, e.offsetY);
        ctx.stroke();

        currentStroke.push({ x: e.offsetX, y: e.offsetY });

        connection.invoke("SendDraw", boardId, e.offsetX, e.offsetY, currentColor, currentSize);
    });

    canvas.addEventListener("mouseup", stopDrawing);
    canvas.addEventListener("mouseleave", () => {
        isInside = false;
        stopDrawing();
    });

    canvas.addEventListener("mouseenter", () => {
        isInside = true;
    });

    /* 🔥 универсальная остановка */
    function stopDrawing() {
        if (!drawing) return;

        drawing = false;

        if (currentStroke.length > 1) {
            connection.invoke("SendStroke", boardId, currentColor, currentSize, currentStroke);
            savePreview();
        }

        currentStroke = [];
        ctx.beginPath(); // 🔥 сброс пути
    }

    function savePreview() {
        const tempCanvas = document.createElement("canvas");
        const scale = 0.2;

        tempCanvas.width = canvas.width * scale;
        tempCanvas.height = canvas.height * scale;

        const tctx = tempCanvas.getContext("2d");

        tctx.fillStyle = "#2c2c54";
        tctx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);

        tctx.drawImage(canvas, 0, 0, canvas.width, canvas.height, 0, 0, tempCanvas.width, tempCanvas.height);

        const image = tempCanvas.toDataURL("image/jpeg", 0.6);

        fetch("/api/preview", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ boardId, image })
        });
    }
</script>