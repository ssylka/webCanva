@page
@model IndexModel
@{
    ViewData["Title"] = "Boards";
}
<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <form method="post" class="d-flex align-items-center gap-2 mb-0">
            <input asp-for="Name"
                   class="form-control"
                   style="width:250px;"
                   placeholder="Board name..."
                   required minlength="1" />

            <button class="btn btn-primary"
                    type="submit"
                    asp-page-handler="Create">
                <i class="bi bi-plus-lg"></i>
            </button>
        </form>

        <input type="text"
               id="search"
               class="form-control"
               style="width:200px;"
               placeholder="🔍 Search..."/>
    </div>

    <div class="row g-4" id="boardsGrid">
        @foreach (var b in Model.Boards)
        {
            <div class="col-md-3 board-card" data-name="@b.Name.ToLower()">

                <div class="card bg-dark text-white h-100 shadow">

                    <a asp-page="Board" asp-route-id="@b.Id">
                        <img src="@(string.IsNullOrEmpty(b.PreviewImage)
                                 ? "/images/tamplate.png"
                                 : b.PreviewImage)"
                             class="card-img-top"
                             style="height:150px; object-fit:cover;" />
                    </a>

                    <div class="card-body">
                        <a asp-page="Board" asp-route-id="@b.Id" style="text-decoration:none; color: whitesmoke;"><h5 class="card-title">@b.Name</h5></a>

                        <div class="d-flex justify-content-between">
                            <button class="btn btn-sm btn-outline-light"
                                    onclick="renameBoard('@b.Id', '@b.Name')">
                                <i class="bi bi-pencil"></i>
                            </button>

                            <form method="post" asp-page-handler="Delete" asp-route-id="@b.Id">
                                <button class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>

</div>
<form method="post" id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>
<script>
    const search = document.getElementById("search");
    const cards = document.querySelectorAll(".board-card");

    document.querySelector("form").addEventListener("submit", e => {
        const input = document.querySelector("input[name='Name']");
        if (!input.value.trim()) {
            e.preventDefault();
            alert("Input a correct name");
        }
    });

    search.addEventListener("input", () => {
        const value = search.value.toLowerCase();

        cards.forEach(c => {
            const name = c.dataset.name;
            c.style.display = name.includes(value) ? "block" : "none";
        });
    });

    function renameBoard(id, oldName) {
        const newName = prompt("New name:", oldName);
        if (!newName) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        const formData = new FormData();
        formData.append("id", id);
        formData.append("name", newName);
        formData.append("__RequestVerificationToken", token);

        fetch("?handler=Rename", {
            method: "POST",
            body: formData
        }).then(res => {
            if (!res.ok) {
                alert("Ошибка: " + res.status);
                return;
            }
            location.reload();
        });
    }
</script>